 /**
+ * Return the active exclusion that blocks a full provider/model id.
+ * Callers use this only for diagnostics; it never clears or bypasses an exclusion.
+ */
+export function findModelExclusion(fullId: string, opts?: { now?: number }): ModelExclusion | undefined {
+	ensureLoaded();
+	const timestamp = opts?.now ?? Date.now();
+	const { provider, modelId } = parseModelKey(fullId);
+	return exclusions.find((entry) => entryMatches(entry, modelId, provider, timestamp));
+}
+
+function diagnosticReason(reason: string | undefined): string {
+	if (!reason) return "provider runtime failure";
+	if (/429|rate.?limit|quota|credit|balance/i.test(reason)) return "provider rate/quota failure";
+	if (/401|auth|api.?key|unauthori[sz]ed/i.test(reason)) return "provider authentication failure";
+	return "provider runtime failure";
+}
+
+/** Format an active exclusion without exposing stored provider error text. */
+export function describeModelExclusion(fullId: string, opts?: { now?: number }): string | undefined {
+	const entry = findModelExclusion(fullId, opts);
+	if (!entry) return undefined;
+	return `model '${fullId}' is excluded until ${new Date(entry.expiresAt).toISOString()} (${diagnosticReason(entry.reason)}).`;
+}
+
+/**
  * Number of live (non-expired) exclusions.
