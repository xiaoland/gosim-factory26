#!/bin/sh
set -eu
: "${E2E_RUNTIME:?E2E_RUNTIME must name the frozen addon}"
: "${FACTORY26_TOOL_NODE:?FACTORY26_TOOL_NODE must name the tool Node}"
PLAYWRIGHT_BROWSERS_PATH="$E2E_RUNTIME/browsers"
LD_LIBRARY_PATH="$E2E_RUNTIME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
TOOL_BIN=$(CDPATH= cd -- "$(dirname -- "$FACTORY26_TOOL_NODE")" && pwd)
FONTCONFIG_PATH="$TOOL_BIN/../etc/fonts"
FONTCONFIG_FILE="$FONTCONFIG_PATH/fonts.conf"
GSETTINGS_SCHEMA_DIR="$TOOL_BIN/../share/glib-2.0/schemas"
XDG_DATA_DIRS="$TOOL_BIN/../share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
export PLAYWRIGHT_BROWSERS_PATH LD_LIBRARY_PATH FONTCONFIG_PATH FONTCONFIG_FILE GSETTINGS_SCHEMA_DIR XDG_DATA_DIRS
exec "$FACTORY26_TOOL_NODE" "$E2E_RUNTIME/node_modules/e2e/dist/cli/bin.js" "$@"
