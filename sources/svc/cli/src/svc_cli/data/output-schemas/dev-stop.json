{
  "$defs": {
    "CapabilityIdentity": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "endpoint_id": {
          "title": "Endpoint Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "worktree",
            "repository",
            "host"
          ],
          "title": "Scope",
          "type": "string"
        },
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "target",
        "endpoint_id",
        "scope_id",
        "capability_id"
      ],
      "title": "CapabilityIdentity",
      "type": "object"
    },
    "CliUsageOutput": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "invalid-cli-usage",
          "default": "invalid-cli-usage",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "CliUsageOutput",
      "type": "object"
    },
    "DevAttempt": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "caller_role": {
          "enum": [
            "owner",
            "follower"
          ],
          "title": "Caller Role",
          "type": "string"
        },
        "cwd": {
          "title": "Cwd",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "failure_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "logs": {
          "$ref": "#/$defs/DevMergedLogs"
        },
        "requested_signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Signal"
        },
        "state": {
          "enum": [
            "starting",
            "running",
            "exited",
            "interrupted",
            "start-failed",
            "capture-failed",
            "owner-lost",
            "released"
          ],
          "title": "State",
          "type": "string"
        },
        "termination_signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Termination Signal"
        },
        "timed_out": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timed Out"
        }
      },
      "required": [
        "caller_role",
        "execution_id",
        "state",
        "argv",
        "cwd",
        "logs"
      ],
      "title": "DevAttempt",
      "type": "object"
    },
    "DevLogReference": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes"
      ],
      "title": "DevLogReference",
      "type": "object"
    },
    "DevMergedLogs": {
      "additionalProperties": false,
      "properties": {
        "merged": {
          "$ref": "#/$defs/DevLogReference"
        }
      },
      "required": [
        "merged"
      ],
      "title": "DevMergedLogs",
      "type": "object"
    },
    "DevStopDeclaration": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "absent",
            "manual",
            "exec"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DevStopDeclaration",
      "type": "object"
    },
    "DevStopOutput": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/DevAttempt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "caller_status": {
          "anyOf": [
            {
              "enum": [
                "detached",
                "interrupted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caller Status"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityIdentity"
        },
        "command": {
          "const": "dev stop",
          "default": "dev stop",
          "title": "Command",
          "type": "string"
        },
        "effective_target_digest": {
          "title": "Effective Target Digest",
          "type": "string"
        },
        "probe": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbeObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "probe_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/MachineErrorBody"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ready": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ready"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "manual-action-required",
            "waiting",
            "stop-failed",
            "stop-unverified",
            "still-ready",
            "stopped"
          ],
          "title": "Status",
          "type": "string"
        },
        "stop": {
          "$ref": "#/$defs/DevStopDeclaration"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceIdentity"
        }
      },
      "required": [
        "target",
        "effective_target_digest",
        "workspace",
        "capability",
        "stop",
        "status",
        "ready"
      ],
      "title": "DevStopOutput",
      "type": "object"
    },
    "JsonValue": {},
    "MachineError": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/MachineErrorBody"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "error"
      ],
      "title": "MachineError",
      "type": "object"
    },
    "MachineErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "MachineErrorBody",
      "type": "object"
    },
    "ProbeObservation": {
      "additionalProperties": false,
      "properties": {
        "endpoint_identity": {
          "title": "Endpoint Identity",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "http",
            "tcp",
            "exec"
          ],
          "title": "Kind",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "output_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Bytes"
        },
        "output_truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Truncated"
        },
        "reason": {
          "enum": [
            "accepted-status",
            "unexpected-status",
            "connected",
            "timeout",
            "unreachable",
            "deadline-exhausted",
            "exec-start-failed",
            "zero-exit",
            "nonzero-exit",
            "output-limit"
          ],
          "title": "Reason",
          "type": "string"
        },
        "responded": {
          "default": false,
          "title": "Responded",
          "type": "boolean"
        },
        "status_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Code"
        }
      },
      "required": [
        "kind",
        "healthy",
        "reason",
        "endpoint_identity"
      ],
      "title": "ProbeObservation",
      "type": "object"
    },
    "WorkspaceIdentity": {
      "additionalProperties": false,
      "description": "Stable identity facts for one executable workspace.",
      "properties": {
        "instance": {
          "title": "Instance",
          "type": "string"
        },
        "namespace_id": {
          "title": "Namespace Id",
          "type": "string"
        },
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "repository_kind": {
          "enum": [
            "git",
            "non-git"
          ],
          "title": "Repository Kind",
          "type": "string"
        },
        "root": {
          "format": "path",
          "title": "Root",
          "type": "string"
        },
        "worktree_id": {
          "title": "Worktree Id",
          "type": "string"
        }
      },
      "required": [
        "root",
        "namespace_id",
        "repository_kind",
        "repository_id",
        "worktree_id",
        "instance"
      ],
      "title": "WorkspaceIdentity",
      "type": "object"
    }
  },
  "$id": "urn:svc:cli-output:dev-stop:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/DevStopOutput"
    },
    {
      "$ref": "#/$defs/MachineError"
    },
    {
      "$ref": "#/$defs/CliUsageOutput"
    }
  ],
  "title": "SVC dev-stop machine output",
  "x-svc-result-schema-version": 2
}
